{
  "expo": {
    "name": "Talise",
    "slug": "talise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talise",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "io.talise.app",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:talise.io",
        "applinks:www.talise.io",
        "applinks:app.talise.io"
      ]
    },
    "android": {
      "package": "io.talise.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "_comment": "App Links, verified against /.well-known/assetlinks.json (web/app/.well-known/assetlinks.json/route.ts). SCOPED to /r/ on purpose: this filter used to claim EVERY path on all three hosts, which was harmless only because verification always failed (no assetlinks.json existed). Now that the file is served, an unscoped filter would swallow the whole marketing site and every link the app has no route for, stranding users on an unmatched route. Add a pathPrefix here only together with a real expo-router route for it (e.g. /c/ needs app/c/[id].tsx before it can be claimed).",
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "talise.io",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "www.talise.io",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "app.talise.io",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Talise uses the camera to scan payment QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17aabaae-65e8-4317-a7ad-f5b32f1af3cd"
      }
    },
    "owner": "iv_dev3"
  }
}
